# ==============================================================================
# Zenith AI Chatbot - Environment Variables Template
# ==============================================================================

# AI API Credentials (Gemini API from Google AI Studio: https://aistudio.google.com/)
AI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Storage & Database (Bucket: chat-uploads)
# Get these from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Pollinations API Key (if using a dedicated tier for image generation)
POLLINATIONS_API_KEY=
